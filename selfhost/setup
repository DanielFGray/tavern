#!/bin/sh
# Writes selfhost/.env from selfhost/env.example, with a fresh random value for each GENERATE.
# It refuses to touch an existing .env, because the secrets must match the data in the volumes.
set -eu

cd -P -- "$(dirname -- "$0")"

if [ -e .env ]; then
  echo "selfhost/.env already exists; edit it by hand." >&2
  exit 1
fi

random_hex() {
  head -c "$1" /dev/urandom | od -An -v -tx1 | tr -d ' \n'
}

umask 077
while IFS= read -r line; do
  case "$line" in
    SECRET_KEY_BASE=GENERATE) echo "SECRET_KEY_BASE=$(random_hex 64)" ;;
    *=GENERATE) echo "${line%%=*}=$(random_hex 24)" ;;
    *) echo "$line" ;;
  esac
done < env.example > .env

echo "Wrote selfhost/.env. Set TAVERN_DOMAIN in it, and mail if you want it, then run:"
echo "  cd selfhost && docker compose up -d --build"
