# Tavern self-host settings. `selfhost/setup` copies this file to selfhost/.env and fills in
# every value marked GENERATE. Edit the rest, then run `docker compose up -d --build` in selfhost/.

# The public name of this server. Its DNS must point at this machine; Caddy gets the
# certificate for it.
TAVERN_DOMAIN=chat.example.com
TAVERN_SERVER_NAME=Tavern

# Secrets. Keep them; changing SECRET_KEY_BASE signs everyone out, and the other three must
# match the data already in the volumes.
SECRET_KEY_BASE=GENERATE
POSTGRES_PASSWORD=GENERATE
TAVERN_DB_API_PASSWORD=GENERATE
S3_ACCESS_KEY_ID=GENERATE
S3_SECRET_ACCESS_KEY=GENERATE

# Mail sends invites, email verification and password resets. Leave MAIL_PROVIDER empty to run
# without mail: then nobody needs to verify an email, and password reset is off.
MAIL_PROVIDER=
EMAIL_FROM=tavern@chat.example.com
SMTP_HOST=
# Defaults to 587 for starttls and 465 for tls.
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
# starttls, tls or none
SMTP_SECURITY=starttls

# Voice and video channels need a Cloudflare Realtime app and TURN key
# (docs/design/voice.md). Leave these empty to run with voice off.
CLOUDFLARE_REALTIME_APP_ID=
CLOUDFLARE_REALTIME_APP_SECRET=
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_KEY_TOKEN=
