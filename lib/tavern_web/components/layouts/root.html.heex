<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title
      default={(@current_server && @current_server.name) || Tavern.Chat.default_server_name()}
      suffix=" · Tavern"
    >
      {assigns[:page_title]}
    </.live_title>
    <%= if Tavern.Chat.server_icon_url(@current_server) do %>
      <link
        rel="icon"
        type="image/png"
        href={Tavern.Chat.server_icon_url(@current_server)}
      />
    <% end %>
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
    <script nonce={@csp_nonce}>
      (() => {
        const setTheme = (theme) => {
          if (theme === "system") {
            localStorage.removeItem("phx:theme");
            document.documentElement.removeAttribute("data-theme");
          } else {
            localStorage.setItem("phx:theme", theme);
            document.documentElement.setAttribute("data-theme", theme);
          }
        };
        if (!document.documentElement.hasAttribute("data-theme")) {
          setTheme(localStorage.getItem("phx:theme") || "system");
        }
        window.addEventListener("storage", (e) => e.key === "phx:theme" && setTheme(e.newValue || "system"));
        
        window.addEventListener("phx:set-theme", (e) => setTheme(e.target.dataset.phxTheme));

        // Side panel widths saved by the PanelResize hook, applied before first paint. The
        // panel's own CSS clamps them, so a width saved on a wider screen still fits.
        try {
          const prefix = "tavern:panel-width:";
          for (let i = 0; i < localStorage.length; i++) {
            const key = localStorage.key(i);
            const width = key.startsWith(prefix) && Number(localStorage.getItem(key));
            if (width > 0) {
              document.documentElement.style.setProperty(`--panel-${key.slice(prefix.length)}-w`, `${width}px`);
            }
          }
        } catch (_) {}
      })();
    </script>
  </head>
  <body>
    {@inner_content}
  </body>
</html>
