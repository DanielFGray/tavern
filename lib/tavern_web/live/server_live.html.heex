<Layouts.app flash={@flash} current_scope={@current_scope}>
  <div
    id="server-shell"
    data-hydrated={to_string(@navigation_ready? and @members_ready?)}
    phx-hook=".TabVisibility"
    class="flex h-dvh flex-col overflow-x-clip overflow-y-hidden bg-base-300 text-base-content transition-colors duration-200 xl:flex-row"
  >
    <script :type={Phoenix.LiveView.ColocatedHook} name=".TabVisibility">
      export default {
        // A message that arrives while the tab is hidden stays unread, so the server must know
        // whether anyone can see the view. The shell mounts once per view, in every channel kind.
        mounted() {
          this.report = () => this.pushEvent("tab_visibility", {visible: document.visibilityState === "visible"})
          document.addEventListener("visibilitychange", this.report)
          this.report()
        },
        reconnected() {
          this.report()
        },
        destroyed() {
          document.removeEventListener("visibilitychange", this.report)
        }
      }
    </script>
    <TavernWeb.ServerComponents.mobile_overlays server={assigns} />
    <TavernWeb.ServerComponents.mobile_channel_drawer server={assigns} />
    <%!-- Outside the drawer: the drawer's transform would make it the popover's fixed frame. --%>
    <TavernWeb.ServerComponents.ChannelEditor.settings_popover
      :if={@channel_settings_id}
      server={assigns}
    />

    <section class="flex min-h-0 min-w-0 flex-1 flex-col overflow-hidden bg-base-200 transition-colors duration-200">
      <TavernWeb.ServerComponents.Verification.banner user={@current_user} />
      <TavernWeb.ServerComponents.active_channel_view :if={@active_channel} server={assigns} />
    </section>

    <%!-- The voice session hook owns the browser's WebRTC media; the div itself stays empty. --%>
    <div
      id="voice-session"
      phx-hook=".VoiceSession"
      phx-update="ignore"
      class="hidden"
      aria-hidden="true"
    >
      <script :type={Phoenix.LiveView.ColocatedHook} name=".VoiceSession">
        export default {
          mounted() {
            this.room = null
            this.midToPublisher = new Map()
            this.videoStreams = new Map()
            this.speaking = false
            this.published = { mic: false, camera: false, screen: false }

            this.handleEvent("voice_ready", (data) => this.start(data))
            this.handleEvent("voice_sf_offer", (data) => this.applyRemoteOffer(data))
            this.handleEvent("voice_mic_state", (data) => this.setMicEnabled(!data.muted))
            this.handleEvent("voice_moderated_mute", () => this.setMicEnabled(false))
            this.handleEvent("voice_video_request", (data) => this.toggleVideo(data.kind, data.active))
            this.handleEvent("voice_ended", () => this.stop())
            this.handleEvent("voice_replaced", () => this.stop())

            // A tile's video area mounts when the server records a published kind, and again
            // whenever the reader returns to the voice channel.
            this.onVideoArea = (e) => this.attachVideo(e.detail.userId, e.detail.kind)
            document.addEventListener("voice:video-area", this.onVideoArea)
          },

          async start(data) {
            this.stop()
            this.iceServers = data.ice_servers || []
            this.userId = data.user_id
            this.published = { mic: false, camera: false, screen: false }

            try {
              const stream = await navigator.mediaDevices.getUserMedia({
                audio: { echoCancellation: true, noiseSuppression: true, autoGainControl: true },
              })
              this.micStream = stream
            } catch (err) {
              this.pushEvent("voice_permission_denied", {})
              return
            }

            this.pcPublish = this.newPeerConnection()
            const micTrack = this.micStream.getAudioTracks()[0]
            const transceiver = this.pcPublish.addTransceiver(micTrack, { direction: "sendonly" })
            micTrack.enabled = true

            this.publish("mic", transceiver)
            this.published.mic = true

            this.startSpeakingDetection(micTrack)
          },

          // The controls bar asks the server first (it authorizes), and the server answers
          // with `voice_video_request`. `active` means the member is publishing that kind, so
          // the click turns it off.
          async toggleVideo(kind, active) {
            if (!this.pcPublish) return
            if (active) {
              this.stopVideo(kind)
              this.pushEvent("voice_unpublish", { kind })
              return
            }

            const stream =
              kind === "camera"
                ? await navigator.mediaDevices.getUserMedia({ video: { width: 1280, height: 720 } })
                : await navigator.mediaDevices.getDisplayMedia({ video: true, audio: false })

            if (!stream) return
            this[kind + "Stream"] = stream
            const track = stream.getVideoTracks()[0]
            // The reader's own video never comes back from the SFU; it previews from the capture.
            this.videoStreams.set(`${this.userId}:${kind}`, track)

            // The browser's own Stop sharing bar kills the track; the room must hear about it.
            track.onended = () => {
              if (this.published[kind]) {
                this.stopVideo(kind)
                this.pushEvent("voice_unpublish", { kind })
              }
            }

            const transceiver = this.pcPublish.addTransceiver(track, {
              direction: "sendonly",
              sendEncodings: [
                { rid: "f", scaleResolutionDownBy: 1 },
                { rid: "h", scaleResolutionDownBy: 2 },
                { rid: "q", scaleResolutionDownBy: 4 },
              ],
            })

            this.publish(kind, transceiver)
            this.published[kind] = true
          },

          // Offers on the publish connection run one at a time. An offer made before the
          // previous answer arrives replaces that offer, and the late answer then fails. The
          // server replies to `voice_publish` with the SFU answer, or with nothing on a refusal.
          publish(kind, transceiver) {
            const pc = this.pcPublish
            this.publishing = (this.publishing || Promise.resolve())
              .then(async () => {
                await pc.setLocalDescription(await pc.createOffer())
                await this.waitIce(pc)
                const reply = await this.pushEvent("voice_publish", {
                  kind,
                  sdp: pc.localDescription.sdp,
                  mids: [{ mid: transceiver.mid }],
                })
                if (reply?.session_description && this.pcPublish === pc) {
                  await pc.setRemoteDescription(reply.session_description)
                }
              })
              .catch((err) => console.warn("voice publish failed", kind, err))
          },

          stopVideo(kind) {
            const stream = this[kind + "Stream"]
            if (stream) {
              for (const track of stream.getTracks()) track.stop()
              this[kind + "Stream"] = null
            }
            this.videoStreams.delete(`${this.userId}:${kind}`)
            this.published[kind] = false
          },

          async applyRemoteOffer(data) {
            this.midToPublisher = new Map()
            for (const entry of data.mapping || []) {
              this.midToPublisher.set(entry.mid, entry)
            }

            if (!this.pcRecv) {
              this.pcRecv = this.newPeerConnection()
              this.pcRecv.ontrack = (event) => this.attachRemoteTrack(event)
            }

            await this.pcRecv.setRemoteDescription(data.session_description)
            const answer = await this.pcRecv.createAnswer()
            await this.pcRecv.setLocalDescription(answer)
            await this.waitIce(this.pcRecv)

            this.pushEvent("voice_sf_offer_answer", { sdp: this.pcRecv.localDescription.sdp })
          },

          attachRemoteTrack(event) {
            const publisher = this.midToPublisher.get(event.transceiver.mid)
            const track = event.track
            const userId = publisher ? publisher.userId : "unknown"

            if (track.kind === "audio") {
              // Audio lives in this hook's own `phx-update="ignore"` div: a LiveView patch may
              // re-render the tiles, and a lost element would drop the member's voice.
              const audio = document.createElement("audio")
              audio.autoplay = true
              audio.dataset.publisher = userId
              audio.srcObject = new MediaStream([track])
              this.el.appendChild(audio)
            } else {
              // Video waits in a buffer keyed by publisher and kind, so a tile that appears
              // later (the reader returns to the voice channel) can pick it up again.
              const kind = publisher ? publisher.kind : "video"
              this.videoStreams.set(`${userId}:${kind}`, track)
              this.attachVideo(userId, kind)
            }
          },

          // Places a buffered track in its area once both exist; whichever arrives second calls this.
          attachVideo(userId, kind) {
            const track = this.videoStreams.get(`${userId}:${kind}`)
            const area = document.getElementById(`voice-video-${userId}-${kind}`)
            if (!track || !area) return

            let video = area.querySelector("video")
            if (!video) {
              video = document.createElement("video")
              video.autoplay = true
              video.playsInline = true
              // Sound plays through the hook's own <audio> elements.
              video.muted = true
              // A shared screen keeps its whole picture; a camera fills the tile.
              video.className = kind === "screen" ? "h-full w-full object-contain" : "h-full w-full object-cover"
              area.appendChild(video)
            }
            video.srcObject = new MediaStream([track])
          },

          setMicEnabled(enabled) {
            if (this.micStream) {
              const track = this.micStream.getAudioTracks()[0]
              if (track) track.enabled = enabled
            }
          },

          startSpeakingDetection(track) {
            const ctx = new AudioContext()
            this.audioContext = ctx
            const source = ctx.createMediaStreamSource(new MediaStream([track]))
            const analyser = ctx.createAnalyser()
            analyser.fftSize = 512
            source.connect(analyser)
            const buffer = new Uint8Array(analyser.frequencyBinCount)

            const tick = () => {
              if (!this.audioContext) return
              analyser.getByteFrequencyData(buffer)
              let sum = 0
              for (const v of buffer) sum += v * v
              const level = Math.sqrt(sum / buffer.length) / 255
              const speaking = level > 0.08
              if (speaking !== this.speaking) {
                this.speaking = speaking
                this.pushEvent("voice_speaking", { speaking: String(speaking) })
              }
              requestAnimationFrame(tick)
            }
            requestAnimationFrame(tick)
          },

          newPeerConnection() {
            const pc = new RTCPeerConnection({ iceServers: this.iceServers })
            pc.onconnectionstatechange = () => {
              if (pc.connectionState === "failed" || pc.connectionState === "closed") {
                // Cloudflare will answer a fresh exchange on the next publish; nothing to do here.
              }
            }
            return pc
          },

          waitIce(pc) {
            if (pc.iceGatheringState === "complete") return Promise.resolve()
            return new Promise((resolve) => {
              const done = () => {
                pc.removeEventListener("icegatheringstatechange", onChange)
                resolve()
              }
              const onChange = () => {
                if (pc.iceGatheringState === "complete") done()
              }
              pc.addEventListener("icegatheringstatechange", onChange)
              // Some networks never report complete; gathered-so-far candidates still connect.
              setTimeout(done, 1500)
            })
          },

          stop() {
            this.speaking = false
            this.published = { mic: false, camera: false, screen: false }
            this.audioContext && this.audioContext.close()
            this.audioContext = null
            for (const pc of [this.pcPublish, this.pcRecv]) {
              pc && pc.close()
            }
            this.pcPublish = null
            this.pcRecv = null
            this.publishing = null

            for (const kind of ["mic", "camera", "screen"]) {
              const stream = this[kind + "Stream"]
              if (stream) {
                for (const track of stream.getTracks()) track.stop()
                this[kind + "Stream"] = null
              }
            }

            this.midToPublisher = new Map()
            this.videoStreams = new Map()
            for (const child of [...this.el.children]) child.remove()
          },

          destroyed() {
            document.removeEventListener("voice:video-area", this.onVideoArea)
            this.stop()
          },
        }
      </script>
    </div>

    <%!-- Outside every drawer and panel: a transformed ancestor would become the card's fixed frame. --%>
    <TavernWeb.ServerComponents.ProfileCard.profile_card card={@profile_card} />

    <TavernWeb.ServerComponents.members_drawer server={assigns} />
    <TavernWeb.ServerComponents.Threads.thread_browser :if={@thread_browser} server={assigns} />
  </div>
</Layouts.app>
